{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: relative park visitation by month and state",
  "width": "container",
  "height": 260,
  "data": {"url": "data/seasonality.csv"},
  "params": [{"name": "rowSel", "select": {"type": "point", "fields": ["state"], "on": "click"}}],
  "mark": {"type": "rect", "stroke": "#fffdf7", "strokeWidth": 1.5, "cornerRadius": 2},
  "encoding": {
    "x": {"field": "month", "type": "ordinal", "sort": ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"], "title": null, "axis": {"orient": "top", "labelAngle": 0, "domain": false, "ticks": false}},
    "y": {"field": "state", "type": "ordinal", "sort": ["NT","QLD","WA","SA","NSW","ACT","VIC","TAS"], "title": null, "axis": {"domain": false, "ticks": false}},
    "color": {"field": "index", "type": "quantitative", "scale": {"scheme": "yellowgreen", "domain": [20, 100]}, "legend": {"title": "Visits (% of peak month)", "orient": "bottom", "gradientLength": 220}},
    "opacity": {"condition": {"param": "rowSel", "value": 1}, "value": 0.25},
    "tooltip": [{"field": "state"}, {"field": "month"}, {"field": "index", "title": "% of peak month"}]
  }
}
