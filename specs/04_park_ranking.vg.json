{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ranked lollipop chart: top 10 national parks by visitors",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/parks.csv"
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "visitors_m",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 10"
    }
  ],
  "encoding": {
    "y": {
      "field": "park",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 260
      }
    },
    "x": {
      "field": "visitors_m",
      "type": "quantitative",
      "title": "Annual visitors (millions)",
      "scale": {
        "domain": [
          0,
          3
        ]
      },
      "axis": {
        "values": [
          0,
          0.5,
          1,
          1.5,
          2,
          2.5,
          3
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#c8742c",
        "strokeWidth": 2,
        "opacity": 0.5
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "visitors_m"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 120,
        "color": "#c8742c",
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "park"
          },
          {
            "field": "state"
          },
          {
            "field": "visitors_m",
            "title": "Visitors (m)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 11,
        "color": "#4a4a42"
      },
      "encoding": {
        "text": {
          "field": "visitors_m",
          "format": ".1f"
        }
      }
    }
  ]
}