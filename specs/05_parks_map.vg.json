{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: every national park in Australia, sized by area (CAPAD 2024)",
  "width": "container",
  "height": 400,
  "params": [
    {
      "name": "minArea",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 2000,
        "step": 100,
        "name": "Hide parks smaller than (km²): "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece4d0",
        "stroke": "#fffdf7",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/national_parks_capad2024.csv"
      },
      "mark": {
        "type": "circle",
        "fill": "#4f9157",
        "stroke": "#24663d",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "area_km2",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [
              4,
              900
            ],
            "domain": [
              0,
              36000
            ]
          },
          "legend": {
            "title": "Park area (km²)",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              500,
              5000,
              20000
            ],
            "symbolFillColor": "#4f9157",
            "symbolOpacity": 0.5
          }
        },
        "opacity": {
          "condition": {
            "test": "datum.area_km2 >= minArea",
            "value": 0.5
          },
          "value": 0.03
        },
        "order": {
          "field": "area_km2",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "park",
            "title": "National park"
          },
          {
            "field": "state"
          },
          {
            "field": "area_km2",
            "title": "Area (km²)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 137.6,
            "lat": -22.6,
            "t": "Largest: Munga-Thirri–Simpson Desert, 36,000 km²"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#1d2b22",
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}