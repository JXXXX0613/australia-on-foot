{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart: NSW's ten most visited parks, 2024-25 (NPWS Park Visitation Survey)",
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/nsw_top10_visits_2024_25.csv"
  },
  "transform": [
    {
      "calculate": "replace(replace(datum.park, ' National Park', ''), ' State Conservation Area', ' SCA')",
      "as": "short"
    },
    {
      "calculate": "datum.visits_m * 1000000 / datum.area_km2",
      "as": "per_km2"
    }
  ],
  "encoding": {
    "y": {
      "field": "short",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 200
      }
    },
    "x": {
      "field": "visits_m",
      "type": "quantitative",
      "title": "Visits in 2024-25 (millions)",
      "scale": {
        "domain": [
          0,
          9
        ]
      },
      "axis": {
        "values": [
          0,
          2,
          4,
          6,
          8
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#c8742c",
        "strokeWidth": 2,
        "opacity": 0.5
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "visits_m"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 130,
        "color": "#c8742c",
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "park"
          },
          {
            "field": "visits_m",
            "title": "Visits (millions)"
          },
          {
            "field": "area_km2",
            "title": "Area (km²)",
            "format": ",.0f"
          },
          {
            "field": "per_km2",
            "title": "Visits per km²",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "color": "#4a4a42"
      },
      "encoding": {
        "text": {
          "field": "visits_m",
          "format": ".1f"
        }
      }
    }
  ]
}