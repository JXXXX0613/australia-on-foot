{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth: bushwalking participation rate by state/territory",
  "width": "container",
  "height": 380,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "data/state_participation.csv"
            },
            "key": "state",
            "fields": [
              "participation"
            ]
          }
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fffdf7",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "participation",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              12,
              15,
              18,
              21
            ],
            "range": [
              "#e4eedb",
              "#b9d6a8",
              "#82b779",
              "#4f9157",
              "#24663d"
            ]
          },
          "legend": {
            "title": "Adults who bushwalk (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 200
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 2.5
          },
          "value": 1
        },
        "stroke": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#1d2b22"
          },
          "value": "#fffdf7"
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "State / territory"
          },
          {
            "field": "participation",
            "title": "Participation (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 144.2,
            "lat": -23.5,
            "label": "QLD lowest: 11%"
          },
          {
            "lon": 146.6,
            "lat": -44.6,
            "label": "TAS leads: 23%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#1d2b22",
        "dx": 0,
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}